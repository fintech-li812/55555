[Unit]
Description=Run the cashflow MySQL backup daily
Documentation=file:///opt/cashflow/DEPLOY.md

[Timer]
# 03:17 local, deliberately off the hour so it does not collide with certbot
# renewal or the hourly log rotation.
OnCalendar=*-*-* 03:17:00
RandomizedDelaySec=300
Persistent=true

[Install]
WantedBy=timers.target
