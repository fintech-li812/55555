# =============================================================================
# 敏感配置模板。部署时生成到 /etc/cashflow-agent/agent.env
# 权限必须为 0600，属主 root:cfagent。禁止提交到任何仓库。
# =============================================================================

# ---- 数据库（专用账号 cf_agent，仅 SELECT+INSERT）----
CF_DB_USER=cf_agent
CF_DB_PASSWORD=__CHANGE_ME__

# ---- 接口令牌（除 /healthz 外所有接口都需要 Bearer）----
CF_AGENT_API_TOKEN=__CHANGE_ME__

# ---- 配置文件位置 ----
CF_AGENT_CONFIG=/etc/cashflow-agent/config.yaml

# ---- 推送通道（留空即视为未配置，接口如实返回 not_configured，不会假装发送成功）----
DINGTALK_WEBHOOK=
DINGTALK_SECRET=
AGENT_WEBHOOK_URL=
AGENT_WEBHOOK_TOKEN=
