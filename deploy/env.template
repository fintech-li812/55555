# 工作台对外服务配置模板（不含任何真实密钥，复制为 .env 后再填）
# 安全：本文件不得写入仓库；真实口令只存在于服务器。

# ---------- 对外服务 ----------
# 正式部署由 Nginx 反代，应用只听回环。
WORKBENCH_HOST=127.0.0.1
WORKBENCH_PORT=8000
# 对外域名，多个用逗号分隔。必须与浏览器地址栏完全一致，否则请求被拒。
WORKBENCH_ALLOWED_HOSTS=workbench.example.com
# 留空则每次启动自动生成并打印一次；正式部署建议固定，便于重启后会话不断。
WORKBENCH_TOKEN=

# ---------- V8 三层风控服务（独立进程）----------
# V8 是独立进程，主站以「同源反向代理」把 /v8/api/v8/* 转发给它。
# 生产由 Nginx 的 location /v8/ 完成同一件事，两者任选其一，不要同时配，
# 否则 V8 会被转发两跳。页面因此始终只访问一个源，后端无需开 CORS。
CF_V8_PORT=8010
# 留空则按 CF_V8_PORT 自动拼成 http://127.0.0.1:<CF_V8_PORT>。
# 只允许填回环地址（127.0.0.1 / localhost / ::1），其他值主站会拒绝代理，
# 这是为了防止本服务被当成任意内网代理滥用。
WORKBENCH_V8_ORIGIN=
# 一次 V8 评估含随机森林与压力测试，实测 0.3~0.6 秒；这里留足余量。
WORKBENCH_V8_TIMEOUT=120

# ---------- 页面文件位置（一般不用改）----------
# 留空即取仓库内默认位置：web/工作台_程序计算版.html、web/后端控制台.html、
# web/统一工作台.html。只有把页面放到仓库外时才需要填绝对路径。
WORKBENCH_WEB=
WORKBENCH_CONSOLE=
WORKBENCH_UNIFIED=

# ---------- MCP over HTTP（供千问调用，与页面 REST API 不是一回事）----------
# 仅用于「MCP 服务端口/状态」的展示与探活，填错不影响页面功能。
MCP_HTTP_PORT=8123

# ---------- 数据库（MySQL 只绑 127.0.0.1，与应用同机）----------
# 生产与 QA 的关键差异：
#   QA（entry.py 现有那套）：CF_DB_PORT=13317、CF_DB_USER=root、库名 cfqa_ 前缀、
#                            CF_QA_MODE=1、CF_ALLOW_FIXTURE=1
#   生产：必须用非 root 的专用账号，库名不得为 cfqa_ 前缀，两个开关必须为 0。
#   config.validate() 强制：root 账号与 fixture 数据只允许出现在隔离 QA 库。
CF_TENANT_ID=
CF_COMPANY_ID=
# 受信任的历史固化结果文件；CF_RESULT_SHA256 是它的 SHA256，
# 两者用于对「结果是否被篡改」做校验，不能随意填。
CF_RESULT_FILE=
CF_RESULT_SHA256=
CF_DB_NAME=
CF_DB_HOST=127.0.0.1
CF_DB_PORT=3306
CF_DB_USER=cf_app
CF_DB_PASSWORD=
CF_QA_MODE=0
CF_ALLOW_FIXTURE=0
# 1 表示本实例已绑定千问办公入口
CF_QWEN_BOUND=1

# ---------- 推送（只做出口，不接受入站控制）----------
# 留空即视为未配置，接口会如实返回 not_configured，不会假装发送成功。
DINGTALK_WEBHOOK=
# 钉钉加签密钥；留空则不加签（群机器人设为「自定义关键词」时需要）
DINGTALK_SECRET=
WECOM_WEBHOOK=
