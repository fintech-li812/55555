[Unit]
Description=Cashflow Risk Workbench - 责任机制 HTTP 服务（钉钉确认页 + 对外接口）
Documentation=file:///opt/cashflow/DEPLOY.md
After=network-online.target mysql.service
Wants=network-online.target mysql.service

[Service]
Type=simple
User=cfrun
Group=cfrun
WorkingDirectory=/opt/cashflow/mcp-server/program_v1/src
EnvironmentFile=/opt/cashflow/deploy/.env
Environment=PYTHONIOENCODING=utf-8
Environment=CF_ACC_PORT=8020
ExecStart=/opt/cashflow/venv/bin/python -B -u /opt/cashflow/mcp-server/program_v1/src/v8_acc_server.py 
Restart=always
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes

[Install]
WantedBy=multi-user.target
