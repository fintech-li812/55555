[Unit]
Description=Cashflow Risk Workbench - v8 风控 MCP over HTTP（三层模型等 24 个工具）
Documentation=file:///opt/cashflow/DEPLOY.md
After=network-online.target mysql.service
Wants=network-online.target mysql.service

[Service]
Type=simple
User=cfrun
Group=cfrun
WorkingDirectory=/opt/cashflow/mcp-server/program_v1/src
EnvironmentFile=/opt/cashflow/deploy/.env
Environment=PYTHONIOENCODING=utf-8
Environment=CF_MCP_PORT=8091
ExecStart=/opt/cashflow/venv/bin/python -B -u /opt/cashflow/mcp-server/program_v1/src/v8_mcp_server.py --http --port 8091
Restart=always
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes

[Install]
WantedBy=multi-user.target
