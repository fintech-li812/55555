      }
    },
    {
      "name": "load_param_template",
      "inputSchema": {
        "required": [
          "industry_key"
        ],
        "additionalProperties": false,
        "type": "object",
        "properties": {
          "industry_key": {
            "maxLength": 128,
            "description": "行业编码",
            "type": "string",
            "minLength": 1
          },
          "template_version": {
            "maxLength": 128,
            "description": "指定版本；省略则读取已发布最新版本",
            "type": "string",
            "minLength": 1
          }
        }
      },
      "description": "读取授权范围内行业模板，缺失返回found=false，不替换成其他行业。",
      "annotations": {
        "readOnlyHint": true,
        "idempotentHint": true,
        "openWorldHint": false,
        "destructiveHint": false
      }
    },
    {
      "name": "log_exception",
      "inputSchema": {
        "required": [
          "request_id",
          "source_ref",
          "occurred_at",
          "dept",
          "amount",
          "currency",
          "reason",
          "approval_ref"
        ],
        "additionalProperties": false,
        "type": "object",
        "properties": {
          "source_ref": {
            "maxLength": 128,
            "description": "来源记录引用",
            "type": "string",
            "minLength": 1
          },
          "dept": {
            "maxLength": 128,
            "description": "部门编码",
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "maxLength": 4000,
            "type": "string",
            "minLength": 1
          },
          "amount": {
            "description": "金额，单位元；Decimal解析",
            "pattern": "^-?[0-9]{1,18}(\\.[0-9]{1,2})?$",
            "type": "string"
          },
          "request_id": {
            "maxLength": 128,
            "description": "稳定业务幂等键",
            "type": "string",
            "minLength": 1
          },
          "occurred_at": {
            "description": "RFC3339，必须带时区",
            "format": "date-time",
            "type": "string"
          },
          "approval_ref": {
            "maxLength": 128,
            "description": "可信审批凭据引用",
            "type": "string",
            "minLength": 1
          },
          "currency": {
            "type": "string",
            "enum": [
              "CNY"
            ]
          }
        }
      },
      "description": "核实已有审批凭据后记录例外；不产生审批、不执行付款。",
      "annotations": {
        "readOnlyHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "destructiveHint": false
      }
    },
    {
      "name": "query_exception_stats",
      "inputSchema": {
        "required": [
