{
  "tools": [
    {
      "name": "log_to_mysql",
      "inputSchema": {
        "required": [
          "request_id",
          "source_ref",
          "occurred_at",
          "event_type",
          "payload"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "required": [
                "event_type"
              ],
              "properties": {
                "event_type": {
                  "const": "risk_warning"
                }
              }
            },
            "then": {
              "required": [
                "rule_id",
                "rule_version",
                "risk_level"
              ]
            }
          }
        ],
        "type": "object",
        "properties": {
          "source_ref": {
            "maxLength": 128,
            "description": "来源记录引用",
            "type": "string",
            "minLength": 1
          },
          "risk_level": {
            "type": "string",
            "enum": [
              "green",
              "yellow",
              "red"
            ]
          },
          "rule_version": {
            "maxLength": 128,
            "description": "规则版本",
            "type": "string",
            "minLength": 1
          },
          "event_type": {
            "type": "string",
            "enum": [
              "risk_warning",
              "tracking_changed",
              "parameter_changed",
              "task_result"
            ]
          },
          "request_id": {
            "maxLength": 128,
            "description": "稳定业务幂等键",
            "type": "string",
            "minLength": 1
          },
          "occurred_at": {
            "description": "RFC3339，必须带时区",
            "format": "date-time",
            "type": "string"
          },
          "payload": {
            "type": "object",
            "additionalProperties": true
          },
          "rule_id": {
            "maxLength": 128,
            "description": "规则ID",
            "type": "string",
            "minLength": 1
          }
        }
      },
      "description": "追加千问已生成的审计结果，不执行风险计算；risk_warning必须提供规则、版本和风险等级。",
      "annotations": {
        "readOnlyHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "destructiveHint": false
      }
    },
    {
      "name": "query_rule_stats",
      "inputSchema": {
        "required": [
          "start_at",
          "end_at"
        ],
        "additionalProperties": false,
        "type": "object",
        "properties": {
          "cursor": {
            "maxLength": 128,
            "description": "分页游标",
            "type": "string",
            "minLength": 1
          },
          "risk_level": {
            "type": "string",
            "enum": [
              "green",
              "yellow",
              "red"
            ]
          },
          "rule_version": {
            "maxLength": 128,
            "description": "精确规则版本",
            "type": "string",
            "minLength": 1
          },
          "limit": {
            "default": 50,
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "start_at": {
            "description": "RFC3339，必须带时区",
            "format": "date-time",
            "type": "string"
          },
          "end_at": {
            "description": "RFC3339，必须带时区",
            "format": "date-time",
            "type": "string"
          },
          "rule_id": {
            "maxLength": 128,
            "description": "精确规则ID",
            "type": "string",
            "minLength": 1
          }
        }
      },
      "description": "查询授权企业指定时间内的审计统计，不输出未经反馈验证的准确率。",
      "annotations": {
        "readOnlyHint": true,
        "idempotentHint": true,
        "openWorldHint": false,
        "destructiveHint": false
      }
    },
    {
      "name": "log_feedback",
      "inputSchema": {
        "required": [
          "request_id",
          "source_ref",
          "occurred_at",
          "metric_code",
          "actual_source_ref",
          "evaluation_version",
          "predicted_value",
          "actual_value",
          "currency",
          "accuracy_label",
          "forecast_start_at",
          "forecast_end_at"
        ],
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "audit_id"
            ]
          },
          {
            "required": [
              "forecast_id"
            ]
          }
        ],
        "type": "object",
        "properties": {
          "request_id": {
            "maxLength": 128,
            "description": "稳定业务幂等键",
            "type": "string",
            "minLength": 1
          },
          "predicted_value": {
            "description": "金额，单位元；Decimal解析",
            "pattern": "^-?[0-9]{1,18}(\\.[0-9]{1,2})?$",
            "type": "string"
          },
          "forecast_end_at": {
            "description": "RFC3339，必须带时区",
            "format": "date-time",
            "type": "string"
          },
          "source_ref": {
            "maxLength": 128,
            "description": "来源记录引用",
            "type": "string",
            "minLength": 1
          },
          "occurred_at": {
            "description": "RFC3339，必须带时区",
            "format": "date-time",
            "type": "string"
          },
          "accuracy_label": {
            "type": "string",
            "enum": [
              "accurate",
              "inaccurate",
              "pending"
            ]
          },
          "audit_id": {
            "maxLength": 128,
            "description": "audit_id",
            "type": "string",
            "minLength": 1
          },
          "actual_value": {
            "description": "金额，单位元；Decimal解析",
            "pattern": "^-?[0-9]{1,18}(\\.[0-9]{1,2})?$",
            "type": "string"
          },
          "forecast_start_at": {
            "description": "RFC3339，必须带时区",
            "format": "date-time",
            "type": "string"
          },
          "currency": {
            "type": "string",
            "enum": [
              "CNY"
            ]
          },
          "actual_source_ref": {
            "maxLength": 128,
            "description": "actual_source_ref",
            "type": "string",
            "minLength": 1
          },
          "metric_code": {
            "maxLength": 128,
            "description": "metric_code",
            "type": "string",
            "minLength": 1
          },
          "evaluation_version": {
            "maxLength": 128,
            "description": "evaluation_version",
            "type": "string",
            "minLength": 1
          },
          "forecast_id": {
            "maxLength": 128,
            "description": "forecast_id",
            "type": "string",
            "minLength": 1
          }
        }
      },
      "description": "保存金额预测反馈；audit_id或forecast_id至少一个，单位与观察期必须一致。",
      "annotations": {
        "readOnlyHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "destructiveHint": false
      }
    },
    {
      "name": "query_feedback_stats",
