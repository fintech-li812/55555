          "end_at"
        ],
        "additionalProperties": false,
        "type": "object",
        "properties": {
          "dept": {
            "maxLength": 128,
            "description": "可选部门编码",
            "type": "string",
            "minLength": 1
          },
          "end_at": {
            "description": "RFC3339，必须带时区",
            "format": "date-time",
            "type": "string"
          },
          "cursor": {
            "maxLength": 128,
            "description": "分页游标",
            "type": "string",
            "minLength": 1
          },
          "start_at": {
            "description": "RFC3339，必须带时区",
            "format": "date-time",
            "type": "string"
          },
          "limit": {
            "default": 50,
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          }
        }
      },
      "description": "查询例外笔数及金额；缺少总审批笔数则例外率为null。",
