          "run_id",
          "scenario",
          "scenario_version",
          "input_snapshot",
          "result_snapshot",
          "risk_level"
        ],
        "additionalProperties": false,
        "type": "object",
        "properties": {
          "source_ref": {
            "maxLength": 128,
            "description": "来源记录引用",
            "type": "string",
            "minLength": 1
          },
          "result_snapshot": {
            "type": "object",
            "additionalProperties": true
          },
