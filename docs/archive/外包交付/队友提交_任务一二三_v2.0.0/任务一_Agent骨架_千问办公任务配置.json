  "pipeline": {
    "description": "步骤按顺序执行；除数据闸外，后续均须通过就绪检查。成功只表示真实工具回执与持久化均成功。",
    "steps": [
      {
        "order": 1,
        "operation": "resolve_context_and_read_data",
        "tool": null,
        "phase": "绑定企业与读取数据",
        "on_unbound": "待校验并停止"
      },
      {
        "order": 2,
        "operation": "data_gate",
        "tool": null,
        "phase": "调用工作台已确认数据闸",
        "on_blocked": "停止正式评估，保留拦截结论及证据"
      },
      {
        "order": 3,
        "tool": "load_param_template",
        "phase": "读取已批准参数与企业覆盖版本",
        "required_outputs": [
          "K_yellow",
          "K_red",
          "parameter_version",
          "source"
        ],
        "on_missing": "待校验并停止"
      },
      {
        "order": 4,
        "tool": "quality_check",
        "phase": "数据质量适用性诊断",
        "on_insufficient": "待校验，不将缺失Q填为1"
      },
      {
        "order": 5,
        "tool": "deada_score",
        "phase": "财务健康判别",
        "precondition": "模型和特征契约已批准"
      },
      {
        "order": 6,
        "tool": "rf_predict",
        "phase": "按批准条件复核",
        "precondition": "第三层触发条件成立且训练标签/特征版本已确认",
        "on_not_required": "P=null；记录skipped"
      },
      {
        "order": 7,
        "tool": "fuse",
        "phase": "已批准规则融合",
        "precondition": "融合分支与现金灯合并口径已裁决",
        "on_unresolved": "level=null，待校验"
      },
      {
        "order": 8,
        "tool": "run_stress_test",
        "phase": "仅在请求或已启用计划触发时运行",
        "precondition": "M>0、K_red>0、K_yellow>K_red，实际金额齐全且未重复计入授信"
      },
      {
        "order": 9,
        "operation": "verify_committed_audit_and_report",
        "tool": null,
        "phase": "核对模型日志回执并生成报告",
        "precondition": "成功结果已按同run_id持久化"
      },
      {
        "order": 10,
        "operation": "authorized_external_writeback",
        "tool": null,
        "phase": "仅在明确目标且已授权时回写",
        "on_failure": "writeback_pending，不冒充闭环成功"
      }
    ]
  },
